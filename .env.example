# WeatherGPT — Environment Variables
# Copy to .env and fill in real values

IMD_API_KEY=
# Portal-issued JWT for api.imd.gov.in (login at /public/login.php, copy the
# token). The gateway needs BOTH the key (x-api-key) and the JWT (Bearer) —
# the key alone always 401s. Key without JWT reports UNCONFIGURED naming this.
IMD_JWT=
# Portal account for JWT auto-mint (adapter mints + refreshes hourly itself).
# Leave empty if you paste IMD_JWT manually instead.
IMD_API_EMAIL=
IMD_API_PASSWORD=
LLM_API_KEY=
# Persistent storage. EMPTY = JSON files beside the cache (fine for local demo).
# Set to a PostgreSQL URL and every store (demo alerts, notification log,
# delivery ledger, push subscriptions, watcher state) survives deploys and
# restarts. Tables auto-create on first use. Render free tier:
#   DATABASE_URL=postgresql://user:pass@host/db  (Internal Database URL)
DATABASE_URL=
REDIS_URL=
STT_API_KEY=
TTS_API_KEY=
DEMO_MODE=true
# Real public IMD API (verified 2026-10-09; ref: https://api.imd.gov.in/public/api_reference.html).
# IMD_API_KEY = the JWT for `Authorization: Bearer <JWT>` (issued against your
# api.imd.gov.in API key). No key = IMD stays UNCONFIGURED; hybrid mode still
# serves live SACHET/CAP alerts + Open-Meteo weather without any key.
IMD_BASE_URL=https://api.imd.gov.in/api/v1
# demo = IMD-grade fixtures (stamped DEMO). live = real IMD calls, needs IMD_API_KEY.
# Setting IMD_API_KEY alone does NOT switch the adapter — that is deliberate, so a
# key can be added without silently turning the demo into live data.
IMD_ADAPTER=demo
# IMD kill-switch: credential + IP gated and stalls pages while its gateway
# times out. Default OFF — hybrid serves live Open-Meteo + SACHET/CAP without
# it. Set true only on an IP-allowlisted host with valid IMD credentials.
IMD_ENABLED=false
# IMD endpoint paths. THE ONLY UNVERIFIED PART of the IMD integration: the auth
# header and response handling are tested, but IMD's real path list has not been
# seen (the platform is credential-gated). If the key returns 400/401, change the
# path here rather than in code. See docs/IMD-KEY-ONBOARDING.md.
IMD_PATH_CURRENT=current_wx
IMD_PATH_FORECAST=cityforecastloc
IMD_PATH_WARNING=districtwarning
IMD_PATH_NOWCAST=districtnowcast
# Live sources (all optional — absence is reported, never faked)
OWM_API_KEY=
DATAGOV_API_KEY=
DATAGOV_RESOURCE_ID=
# SACHET/NDMA CAP feeds — verified working 2026-09-23. Comma-separated; the
# national feed plus the states we serve. AP slug trap: only rss_andhra.xml
# works (rss_andhrapradesh.xml times out, rss_andhra_pradesh.xml 404s).
CAP_FEED_URLS=https://sachet.ndma.gov.in/cap_public_website/rss/rss_india.xml,https://sachet.ndma.gov.in/cap_public_website/rss/rss_telangana.xml,https://sachet.ndma.gov.in/cap_public_website/rss/rss_andhra.xml
CAP_FEED_URL=
SARVAM_API_KEY=
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya
WIS2_BROKER=
EMERGENCY_KEY=

# Web Push — required for notifications that arrive while the app is CLOSED.
# Leave blank and the server generates an ephemeral pair at startup, which works
# but invalidates every existing subscription on restart.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:ops@weathergpt.local

# Watcher cadence. The LOCAL lifecycle pass (demo alerts advance + notify) runs
# every DEMO_TICK seconds — the one-tap scenarios are timed for 10s. The NETWORK
# pass (re-check subscribed districts against CAP/IMD) runs every
# ALERT_WATCH_INTERVAL seconds; bulletins change hourly, so 300 is plenty.
DEMO_TICK=10
ALERT_WATCH_INTERVAL=300

# --- VPS deploy (Docker Compose + Caddy): ports, mode, storage, origins -----
# App port INSIDE the container (compose maps "${WGPT_PORT:-8000}:8000" and
# the Dockerfile CMD listens on $PORT; run.py defaults to 8000 too). Caddy
# owns 80/443 and reverse-proxies to 127.0.0.1:8000. On the VPS leave
# WGPT_PORT unset (host port 8000); set it only to dodge a busy local port.
PORT=8000
WGPT_PORT=8000
# Source chain: "demo" | "imd" | "hybrid" (legacy alias "live" = hybrid).
# Empty derives from DEMO_MODE (true -> demo), so the shipped default stays a
# laptop demo. The VPS runs SOURCE_MODE=hybrid (set it in the real .env).
SOURCE_MODE=
# Where the JSON stores live when DATABASE_URL is empty. The container sets
# /app/data/weathergpt_cache.json (persisted in the wgpt-data volume); this
# line is the local-dev equivalent — an absolute path is honoured as-is.
CACHE_FILE=weathergpt_cache.json
# Comma-separated extra origins allowed to call the API (same-origin needs
# nothing). Example: FRONTEND_ORIGINS=https://app.example.com
FRONTEND_ORIGINS=
# Local defaults (Hyderabad). Override per deployment as needed.
DEFAULT_LAT=17.385
DEFAULT_LON=78.4867

# --- IMD request tuning (no code edit needed on key day) -------------------
# Token endpoint for JWT auto-mint when IMD_API_EMAIL/PASSWORD are set.
IMD_TOKEN_URL=https://api.imd.gov.in/api/oauth/token.php
# Where the hex key rides: bearer (x-api-key header, default) | header | query.
IMD_AUTH_SCHEME=bearer
IMD_AUTH_HEADER=Authorization
IMD_AUTH_PARAM=api_key
# Seconds before a live IMD call gives up.
IMD_TIMEOUT=10
# Station/city for live current/forecast calls when the caller passes no district.
IMD_DEFAULT_STATION=Hyderabad
# JSON map of our field name -> provider's actual name, applied to live
# responses only (e.g. {"temp": "Temperature"}). Leave empty until key day.
IMD_FIELD_MAP=

# --- Conversational layer (OpenAI-compatible; Groq by default) --------------
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT=25

# --- Extra alert-chain keys (all optional, absence is reported never faked) -
WEATHERAPI_KEY=
WEATHERUNION_KEY=
