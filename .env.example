# WeatherGPT — Environment Variables
# Copy to .env and fill in real values

IMD_API_KEY=
LLM_API_KEY=
# Persistent storage. EMPTY = JSON files beside the cache (fine for local demo).
# Set to a PostgreSQL URL and every store (demo alerts, notification log,
# delivery ledger, push subscriptions, watcher state) survives deploys and
# restarts. Tables auto-create on first use. Render free tier:
#   DATABASE_URL=postgresql://user:pass@host/db  (Internal Database URL)
DATABASE_URL=
REDIS_URL=
STT_API_KEY=
TTS_API_KEY=
# Single IMD-first mode (2026-09-27): IMD -> Open-Meteo -> OpenWeatherMap for
# weather; SACHET/CAP feeds for alerts; file cache last. There is no mode
# switcher and no SOURCE_MODE / IMD_ADAPTER env vars.
# IMD auth (verified 2026-09-27 against the portal's logged-in API docs):
# every call sends X-API-KEY: <key> + Authorization: Bearer <JWT>; the backend
# mints the JWT from your portal email+password (1h expiry, cached).
IMD_API_EMAIL=
IMD_API_PASSWORD=
# The key is bound to the server IP registered on the portal — a dev key bound
# to your laptop IP answers only from your laptop. See docs/IMD-KEY-ONBOARDING.md.
IMD_BASE_URL=https://api.imd.gov.in/api/v1
# IMD endpoint paths (verified against the portal API docs).
IMD_PATH_CURRENT=current_wx
IMD_PATH_FORECAST=cityforecastloc
IMD_PATH_WARNING=districtwarning
IMD_PATH_NOWCAST=nowcast
# Station/district ID mapping: the API takes numeric IDs (?id=...), not names.
# ANY Indian location resolves automatically: the backend fetches IMD's own
# mapping tables once (same dual-header auth) and caches them for 7 days.
# Nearest IMD station by GPS -> current/forecast; district name -> warning/nowcast.
# A station >150 km away fails closed to Open-Meteo (outside IMD coverage).
# IMD_STATION_IDS below is a MANUAL OVERRIDE for pinning a wrong auto-match.
# The mapping endpoint names are best-effort guesses (portal docs are
# login-gated) — if the fetch 404s, copy the exact names from
# https://api.imd.gov.in/public/api_docs.php into these two vars.
IMD_PATH_STATION_MAPPING=stationmapping
IMD_PATH_DISTRICT_MAPPING=districtmapping
# IMD_MAPPING_TTL_S=604800
# IMD_STATION_IDS={"Hyderabad": {"current": "<station-id>", "forecast": "<station-code>", "warning": "<district-id>", "nowcast": "<district-id>"}}
# IMD_DEFAULT_DISTRICT=Hyderabad
# Live sources (all optional — absence is reported, never faked)
OWM_API_KEY=
DATAGOV_API_KEY=
DATAGOV_RESOURCE_ID=
# SACHET/NDMA CAP feeds — verified working 2026-09-23. Comma-separated; the
# national feed plus the states we serve. AP slug trap: only rss_andhra.xml
# works (rss_andhrapradesh.xml times out, rss_andhra_pradesh.xml 404s).
CAP_FEED_URLS=https://sachet.ndma.gov.in/cap_public_website/rss/rss_india.xml,https://sachet.ndma.gov.in/cap_public_website/rss/rss_telangana.xml,https://sachet.ndma.gov.in/cap_public_website/rss/rss_andhra.xml
CAP_FEED_URL=
SARVAM_API_KEY=
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
# Saaras v3 is Sarvam's current recommended STT model (saarika:v2.5 is deprecated).
SARVAM_STT_MODEL=saaras:v3
# Optional override for live-mic streaming STT. When unset, the app derives
# wss://<stt-host>/speech-to-text-translate/streaming from SARVAM_STT_URL.
# SARVAM_STT_WS_URL=wss://api.sarvam.ai/speech-to-text-translate/streaming
SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya
# WIS2 (optional, unverified): public global brokers need no private key.
# Live MQTT subscription is NOT implemented in the MVP — CAP polling remains
# the official-warning path. Leave blank unless testing.
# WIS2_BROKER=mqtts://everyone:everyone@globalbroker.meteo.fr:8883
# WIS2_TOPICS=origin/a/wis2/#
WIS2_BROKER=
EMERGENCY_KEY=

# Web Push — required for notifications that arrive while the app is CLOSED.
# Leave blank and the server generates an ephemeral pair at startup, which works
# but invalidates every existing subscription on restart.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:ops@weathergpt.local

# Watcher cadence. The loop wakes every WATCH_TICK seconds; the NETWORK pass
# (re-check subscribed districts against CAP/IMD) runs every
# ALERT_WATCH_INTERVAL seconds; bulletins change hourly, so 300 is plenty.
WATCH_TICK=10
ALERT_WATCH_INTERVAL=300
