# WeatherGPT — Environment Variables
# Copy to .env and fill in real values

IMD_API_KEY=
LLM_API_KEY=
# Persistent storage. EMPTY = JSON files beside the cache (fine for local demo).
# Set to a PostgreSQL URL and every store (demo alerts, notification log,
# delivery ledger, push subscriptions, watcher state) survives deploys and
# restarts. Tables auto-create on first use. Render free tier:
#   DATABASE_URL=postgresql://user:pass@host/db  (Internal Database URL)
DATABASE_URL=
REDIS_URL=
STT_API_KEY=
TTS_API_KEY=
DEMO_MODE=true
IMD_BASE_URL=https://mausam.imd.gov.in/api/v1
# demo = IMD-grade fixtures (stamped DEMO). live = real IMD calls, needs IMD_API_KEY.
# Setting IMD_API_KEY alone does NOT switch the adapter — that is deliberate, so a
# key can be added without silently turning the demo into live data.
IMD_ADAPTER=demo
# IMD endpoint paths. THE ONLY UNVERIFIED PART of the IMD integration: the auth
# header and response handling are tested, but IMD's real path list has not been
# seen (the platform is credential-gated). If the key returns 400/401, change the
# path here rather than in code. See docs/IMD-KEY-ONBOARDING.md.
IMD_PATH_CURRENT=current_wx
IMD_PATH_FORECAST=cityforecastloc
IMD_PATH_WARNING=districtwarning
IMD_PATH_NOWCAST=districtnowcast
# Live sources (all optional — absence is reported, never faked)
OWM_API_KEY=
DATAGOV_API_KEY=
DATAGOV_RESOURCE_ID=
CAP_FEED_URL=
SARVAM_API_KEY=
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya
WIS2_BROKER=
EMERGENCY_KEY=

# Web Push — required for notifications that arrive while the app is CLOSED.
# Leave blank and the server generates an ephemeral pair at startup, which works
# but invalidates every existing subscription on restart.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:ops@weathergpt.local

# Watcher cadence. The LOCAL lifecycle pass (demo alerts advance + notify) runs
# every DEMO_TICK seconds — the one-tap scenarios are timed for 10s. The NETWORK
# pass (re-check subscribed districts against CAP/IMD) runs every
# ALERT_WATCH_INTERVAL seconds; bulletins change hourly, so 300 is plenty.
DEMO_TICK=10
ALERT_WATCH_INTERVAL=300
