{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "X-Goog-Api-Key": "{file:~/.config/opencode/secrets/stitch-key}"
      }
    }
  }
}
