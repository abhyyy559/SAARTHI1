{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SAARTHI: Install backend dependencies",
      "type": "shell",
      "command": "python -m pip install -r backend/requirements.txt",
      "options": { "cwd": "${workspaceFolder}/weathergpt" },
      "inAgents": true,
      "runOptions": { "runOn": "worktreeCreated" },
      "problemMatcher": []
    },
    {
      "label": "SAARTHI: Install frontend dependencies",
      "type": "shell",
      "command": "npm.cmd install",
      "options": { "cwd": "${workspaceFolder}/weathergpt/frontend-react" },
      "inAgents": true,
      "runOptions": { "runOn": "worktreeCreated" },
      "problemMatcher": []
    },
    {
      "label": "SAARTHI: Backend (live)",
      "type": "shell",
      "command": "python -m uvicorn backend.main:app --host 127.0.0.1 --port 8003 --reload",
      "options": {
        "cwd": "${workspaceFolder}/weathergpt",
        "env": { "DEMO_MODE": "false", "IMD_ADAPTER": "live" }
      },
      "inAgents": true,
      "problemMatcher": []
    },
    {
      "label": "SAARTHI: Frontend",
      "type": "shell",
      "command": "npm.cmd run dev -- --host 127.0.0.1 --port 5173 --strictPort",
      "options": { "cwd": "${workspaceFolder}/weathergpt/frontend-react" },
      "inAgents": true,
      "problemMatcher": []
    }
  ]
}
